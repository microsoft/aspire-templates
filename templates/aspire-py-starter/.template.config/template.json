{
  "$schema": "https://json.schemastore.org/template",
  "author": "Microsoft",
  "identity": "Aspire.TemplatesLab.Starter.Python.TypeScript",
  "name": "Aspire Starter App (FastAPI/React, TypeScript AppHost)",
  "description": "An Aspire TypeScript AppHost with a Python FastAPI backend, React frontend, and optional Redis caching.",
  "shortName": "aspire-py-starter",
  "defaultName": "AspireApp",
  "classifications": ["Aspire", "TypeScript", "Python", "FastAPI", "React"],
  "tags": {
    "language": "TypeScript",
    "type": "project"
  },
  "symbols": {
    "projectNameLower": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "lowerCaseInvariant",
      "replaces": "{{projectNameLower}}"
    },
    "AspireVersion": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "SDK version supplied by the running Aspire CLI.",
      "replaces": "{{aspireVersion}}"
    },
    "HostingJavaScriptVersion": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "The version of Aspire.Hosting.JavaScript.",
      "replaces": "{{hostingJavaScriptVersion}}"
    },
    "HostingPythonVersion": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "description": "The version of Aspire.Hosting.Python.",
      "replaces": "{{hostingPythonVersion}}"
    },
    "HostingRedisVersion": {
      "type": "parameter",
      "datatype": "string",
      "isRequired": true,
      "isEnabled": "UseRedisCache",
      "description": "The version of Aspire.Hosting.Redis.",
      "replaces": "{{hostingRedisVersion}}"
    },
    "UseRedisCache": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use Redis for caching. Requires a supported container runtime."
    },
    "LocalhostTld": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "description": "Use the lowercased project name with .dev.localhost instead of localhost."
    },
    "httpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 15000, "high": 15299 },
      "replaces": "{{httpPort}}"
    },
    "httpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 17000, "high": 17299 },
      "replaces": "{{httpsPort}}"
    },
    "otlpHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 19000, "high": 19299 },
      "replaces": "{{otlpHttpPort}}"
    },
    "otlpHttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 21000, "high": 21299 },
      "replaces": "{{otlpHttpsPort}}"
    },
    "resourceHttpPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 20000, "high": 20299 },
      "replaces": "{{resourceHttpPort}}"
    },
    "resourceHttpsPort": {
      "type": "generated",
      "generator": "port",
      "parameters": { "low": 22000, "high": 22299 },
      "replaces": "{{resourceHttpsPort}}"
    }
  },
  "specialCustomOperations": {
    "**/*.py": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["# #if"],
            "else": ["# #else"],
            "endif": ["# #endif"],
            "evaluator": "C++2",
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    },
    "**/*.toml": {
      "operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": ["# #if"],
            "else": ["# #else"],
            "endif": ["# #endif"],
            "evaluator": "C++2",
            "trim": true,
            "wholeLine": true
          }
        }
      ]
    }
  },
  "primaryOutputs": [
    { "path": "apphost.mts" }
  ]
}
